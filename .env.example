# Copy this file to .env and fill in real values.
# .env is git-ignored so your keys never get committed.

# Which port the Express server listens on locally
PORT=3000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Claude API key — not used yet in the hello-world slice, but the
# assistant logic (natural-language chores, calendar parsing, etc.)
# will read this once we build that feature.
ANTHROPIC_API_KEY=
