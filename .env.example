# Copy this file to .env and fill in real values.
# .env is git-ignored so your keys never get committed.

# Which port the Express server listens on locally
PORT=3000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The "service_role" secret key (same dashboard page, further down).
# This one bypasses Row Level Security, so it's used only by trusted
# server code (see server/lib/tokenStore.js) — never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth credentials (from console.cloud.google.com, under
# APIs & Services > Credentials). Used for "Connect Google Calendar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Resideo (Honeywell Home) OAuth credentials (from
# developer.honeywellhome.com, after registering an app). Used for
# "Connect thermostat" on the Smart Home page. Requires a real Resideo
# thermostat on your account — there's no sandbox/simulator.
RESIDEO_CLIENT_ID=
RESIDEO_CLIENT_SECRET=
RESIDEO_REDIRECT_URI=http://localhost:3000/auth/resideo/callback

# Claude API key — powers the natural-language chores/bills parsing and the
# plain-language comps summary.
ANTHROPIC_API_KEY=

# RentCast API key (from app.rentcast.io, under API dashboard) — powers the
# home sale comps tracker. Free developer tier is 50 requests/month, which
# comfortably covers a weekly pull.
RENTCAST_API_KEY=

# Your house's own details, used to look up comparable sales. HOME_ADDRESS
# never gets committed to the repo or shared anywhere else — it only lives
# here and gets sent, server-side, straight to RentCast.
HOME_ADDRESS=
HOME_PROPERTY_TYPE=Condo
HOME_BEDROOMS=3
HOME_BATHROOMS=2.5
HOME_SQUARE_FOOTAGE=2000
HOME_COMP_RADIUS_MILES=0.4
HOME_COMP_COUNT=10

# A random string (16+ characters) that only Vercel and this app know about.
# Vercel automatically sends it as an Authorization header when it triggers
# the weekly comps refresh — see the "Home sale comps tracker" README
# section for why this matters. Not required for local dev (the refresh
# route just skips the check if this is unset).
CRON_SECRET=
