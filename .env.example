# Copy this file to .env and fill in real values.
# .env is git-ignored so your keys never get committed.

# Which port the Express server listens on locally
PORT=3000

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The "service_role" secret key (same dashboard page, further down).
# This one bypasses Row Level Security, so it's used only by trusted
# server code (see server/lib/tokenStore.js) — never send it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth credentials (from console.cloud.google.com, under
# APIs & Services > Credentials). Used for "Connect Google Calendar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Claude API key — not used yet, but the assistant logic (natural-language
# chores, calendar parsing, etc.) will read this once we build that feature.
ANTHROPIC_API_KEY=
