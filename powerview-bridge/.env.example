# Copy this file to .env and fill in real values.
# .env is git-ignored so nothing here gets committed.

# The PowerView Gen 3 hub's address on your home network — an IP (e.g.
# 192.168.1.50) or its mDNS hostname if it advertises one. Find it via
# your router's connected-devices list, or the PowerView app's
# gateway/hub info screen.
POWERVIEW_HUB_HOST=

# Same Supabase project the main Benny app uses (Settings > API). The
# anon key is enough here — powerview_shades has no RLS, same treatment
# as the app's other non-credential tables (see root README "Stage 8").
SUPABASE_URL=
SUPABASE_ANON_KEY=

# How often to poll the hub, in seconds.
POLL_INTERVAL_SECONDS=60
