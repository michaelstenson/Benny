{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "index.js" },
    { "src": "/auth/(.*)", "dest": "index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "index.js" }
  ],
  "crons": [{ "path": "/api/comps/refresh", "schedule": "0 13 * * 1" }]
}
